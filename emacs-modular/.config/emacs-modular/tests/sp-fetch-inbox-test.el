;;; sp-fetch-inbox-test.el --- Tests for sp-fetch-inbox -*- lexical-binding: t; -*-

(require 'ert)
(defvar sp-literature-dir (make-temp-file "lit" t))
(defvar sp-bibtex-files nil)
(defvar sp-bibliography-dir nil)
(require 'sp-fetch-inbox)

(defconst sp-fetch-inbox-test--bib
  "@article{smith2020,\n  author = {Smith, Jane},\n  title = {Attention is a thing},\n  journal = {J},\n  year = {2020},\n}\n")

(ert-deftest sp-fetch-inbox-parse-records ()
  (let ((items (sp-fetch-inbox--parse-records "U1\ta.pdf\t/x/a.pdf\nU2\tb\t\nbad\n")))
    (should (= (length items) 2))
    (should (equal (plist-get (car items) :file) "/x/a.pdf"))
    (should-not (plist-get (car items) :imported))
    (should (plist-get (cadr items) :imported))
    (should-not (plist-get (cadr items) :file))))

(ert-deftest sp-fetch-inbox-folder-files-and-merge ()
  (let* ((dir (make-temp-file "inbox" t))
         (sp-fetch-inbox-dir dir))
    (make-directory (expand-file-name "mac-bibdesk" dir))
    (dolist (f '("a.pdf" "b.pdf" "mac-bibdesk/old.pdf" "c.txt"))
      (write-region "" nil (expand-file-name f dir)))
    (let ((files (sp-fetch-inbox--folder-files)))
      (should (equal (sort (mapcar #'file-name-nondirectory files) #'string<) '("a.pdf" "b.pdf")))
      (let ((items (sp-fetch-inbox--merge
                    (list (list :uuid "U1" :name "a.pdf" :file (expand-file-name "a.pdf" dir))
                          (list :uuid "U2" :name "x" :file nil :imported t))
                    files)))
        (should (= (length items) 3))
        (should (equal (mapcar (lambda (i) (plist-get i :name)) items) '("a.pdf" "x" "b.pdf")))))))

(ert-deftest sp-fetch-inbox-find-doi ()
  (should (equal (sp-fetch-inbox--find-doi "see https://doi.org/10.1016/j.x.2020.01.002.\nmore")
                 "10.1016/j.x.2020.01.002"))
  (should-not (sp-fetch-inbox--find-doi "no identifier here")))

(ert-deftest sp-fetch-inbox-unique-key ()
  (should (equal (sp-fetch-inbox--unique-key "k" (lambda (_) nil)) "k"))
  (should (equal (sp-fetch-inbox--unique-key "k" (lambda (k) (member k '("k" "ka")))) "kb")))

(ert-deftest sp-fetch-inbox-key-taken ()
  (let* ((bib (make-temp-file "x" nil ".bib"))
         (sp-bibtex-files (list bib)))
    (write-region sp-fetch-inbox-test--bib nil bib)
    (should (sp-fetch-inbox--key-taken-p "smith2020"))
    (should-not (sp-fetch-inbox--key-taken-p "smith2021"))))

(ert-deftest sp-fetch-inbox-entry-key-roundtrip ()
  (with-temp-buffer
    (insert (sp-fetch-inbox--skeleton "/x/my-paper_draft.pdf"))
    (should (equal (sp-fetch-inbox--entry-key) "newkey"))
    (should (string-match-p "title = {my paper draft}" (buffer-string)))
    (sp-fetch-inbox--set-key "doe2001x")
    (should (equal (sp-fetch-inbox--entry-key) "doe2001x"))))

(ert-deftest sp-fetch-inbox-insert-entry-makes-key ()
  (with-temp-buffer
    (bibtex-mode)
    (let ((sp-bibtex-files nil))
      (sp-fetch-inbox--insert-entry (replace-regexp-in-string "smith2020" "zzz" sp-fetch-inbox-test--bib)))
    (should (string-match-p "smith" (sp-fetch-inbox--entry-key)))
    (should-not (equal (sp-fetch-inbox--entry-key) "zzz"))))

(ert-deftest sp-fetch-inbox-skeleton-keeps-placeholder ()
  (with-temp-buffer
    (bibtex-mode)
    (sp-fetch-inbox--insert-entry (sp-fetch-inbox--skeleton "/x/p.pdf"))
    (should (equal (sp-fetch-inbox--entry-key) "newkey"))
    (should-error (sp-fetch-inbox--make-key) :type 'user-error)))

(ert-deftest sp-fetch-inbox-file-script ()
  (let ((s (sp-fetch-inbox--file-script "U-1" "smith2020" nil)))
    (should (string-match-p "r.name = \"smith2020.pdf\"" s))
    (should (string-match-p "db.root()" s)))
  (should (string-match-p "getRecordAt(\"/papers\"" (sp-fetch-inbox--file-script "U" "k" "papers"))))

(ert-deftest sp-fetch-inbox-file-pdf-plain-file ()
  (let* ((dir (make-temp-file "inbox" t))
         (src (expand-file-name "dl.pdf" dir))
         (dest (expand-file-name "k.pdf" (make-temp-file "lit" t))))
    (write-region "%PDF" nil src)
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () nil)))
      (sp-fetch-inbox--file-pdf (list :file src :name "dl.pdf") "k" dest))
    (should (file-exists-p dest))
    (should-not (file-exists-p src))))

(ert-deftest sp-fetch-inbox-file-pdf-indexed-checks-readback ()
  (let* ((dir (make-temp-file "lit" t))
         (old (expand-file-name "old.pdf" dir))
         (dest (expand-file-name "k.pdf" dir)))
    (write-region "%PDF" nil old)
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () t))
              ((symbol-function 'sp-reading--jxa) (lambda (_) old)))
      (should-error (sp-fetch-inbox--file-pdf (list :uuid "U" :file old) "k" dest)))
    (write-region "%PDF" nil dest)
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () t))
              ((symbol-function 'sp-reading--jxa) (lambda (_) dest)))
      (should (equal (sp-fetch-inbox--file-pdf (list :uuid "U" :file old) "k" dest) dest)))))

(ert-deftest sp-fetch-inbox-append ()
  (let ((bib (make-temp-file "x" nil ".bib")))
    (write-region "@book{a,\n}\n" nil bib)
    (sp-fetch-inbox--append bib sp-fetch-inbox-test--bib)
    (with-temp-buffer
      (insert-file-contents bib)
      (should (string-match-p "@book{a,\n}\n\n@article{smith2020" (buffer-string))))))

(ert-deftest sp-fetch-inbox-confirm-flow ()
  (let* ((lit sp-literature-dir)
         (inbox (make-temp-file "inbox" t))
         (src (expand-file-name "dl.pdf" inbox))
         (bib (make-temp-file "x" nil ".bib"))
         (sp-bibtex-files (list bib))
         (sp-bibliography-dir (file-name-directory bib))
         (item (list :file src :name "dl.pdf")))
    (write-region "%PDF" nil src)
    (write-region "" nil bib)
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () nil))
              ((symbol-function 'y-or-n-p) (lambda (&rest _) t))
              ((symbol-function 'sp-fetch-inbox-items) (lambda () nil))
              ((symbol-function 'sp--fetch-academic-attach)
               (lambda (file)
                 (goto-char (point-max))
                 (search-backward "}")
                 (insert "  file = {" (file-relative-name file sp-bibliography-dir) "},\n"))))
      (let ((edit (generate-new-buffer "*t*")))
        (with-current-buffer edit
          (sp-fetch-inbox-edit-mode)
          (setq sp-fetch-inbox--item item sp-fetch-inbox--bibfile bib)
          (insert (replace-regexp-in-string "smith2020" "doe2020x" sp-fetch-inbox-test--bib))
          (sp-fetch-inbox-confirm))))
    (should (file-exists-p (expand-file-name "doe2020x.pdf" lit)))
    (with-temp-buffer
      (insert-file-contents bib)
      (should (string-match-p "@article{doe2020x," (buffer-string)))
      (should (string-match-p "file = {[^}]*doe2020x.pdf}" (buffer-string))))))

(ert-deftest sp-fetch-inbox-confirm-refuses-placeholder-and-taken ()
  (let* ((bib (make-temp-file "x" nil ".bib"))
         (sp-bibtex-files (list bib)))
    (write-region sp-fetch-inbox-test--bib nil bib)
    (with-temp-buffer
      (sp-fetch-inbox-edit-mode)
      (setq sp-fetch-inbox--item (list :file "/x.pdf"))
      (insert (sp-fetch-inbox--skeleton "/x.pdf"))
      (should-error (sp-fetch-inbox-confirm) :type 'user-error)
      (sp-fetch-inbox--set-key "smith2020")
      (should-error (sp-fetch-inbox-confirm) :type 'user-error))))

(ert-deftest sp-fetch-inbox-sync-metadata ()
  (let (called msgs)
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () t))
              ((symbol-function 'require) (lambda (f &rest _) (or (eq f 'sp-devonthink-bibsync) t)))
              ((symbol-function 'sp-devonthink-bibsync-entry)
               (lambda (key text) (setq called (list key text)) '(:records 1)))
              ((symbol-function 'message) (lambda (f &rest a) (push (apply #'format f a) msgs))))
      (sp-fetch-inbox--sync-metadata "k1" "@article{k1,}")
      (should (equal called '("k1" "@article{k1,}")))
      ;; option off: nothing is called
      (setq called nil)
      (let ((sp-fetch-inbox-sync-metadata nil))
        (sp-fetch-inbox--sync-metadata "k1" "x"))
      (should-not called)
      ;; a failure is reported, not signalled
      (cl-letf (((symbol-function 'sp-devonthink-bibsync-entry) (lambda (&rest _) (error "boom"))))
        (sp-fetch-inbox--sync-metadata "k1" "x"))
      (should (string-match-p "not copied: boom" (car msgs))))))

(ert-deftest sp-fetch-inbox-hints-in-echo-area-not-header ()
  (with-temp-buffer
    (sp-fetch-inbox-edit-mode)
    (sp-fetch-inbox--set-hints "no DOI found")
    (should-not header-line-format)
    (should (equal sp-echo-help--hints sp-fetch-inbox--hints))
    (should (equal sp-echo-help--note "no DOI found"))
    (should sp-echo-help-mode)))

(defun sp-fetch-inbox-test--items ()
  (list (list :name "b.pdf" :added 300 :subdir "Urgent")
        (list :name "A.pdf" :added 100)
        (list :name "c.pdf" :added 200)
        (list :name "d.pdf" :added 400 :uuid "U")))

(ert-deftest sp-fetch-inbox-parse-records-added-and-subdir ()
  (let ((items (sp-fetch-inbox--parse-records "U1\ta.pdf\t/x/a.pdf\t1700000000\tSub/Deep\nU2\tb\t\t\t\n")))
    (should (equal (plist-get (car items) :added) 1700000000))
    (should (equal (plist-get (car items) :subdir) "Sub/Deep"))
    (should-not (plist-get (cadr items) :added))
    (should-not (plist-get (cadr items) :subdir))))

(ert-deftest sp-fetch-inbox-folder-files-have-subdir-and-time ()
  (let* ((dir (make-temp-file "inbox" t))
         (sp-fetch-inbox-dir dir))
    (make-directory (expand-file-name "Urgent/Deep" dir) t)
    (write-region "" nil (expand-file-name "a.pdf" dir))
    (write-region "" nil (expand-file-name "Urgent/Deep/b.pdf" dir))
    (let ((items (sp-fetch-inbox--merge nil (sp-fetch-inbox--folder-files))))
      (should (equal (sort (mapcar (lambda (i) (plist-get i :subdir)) items)
                           (lambda (a b) (string< (or a "") (or b ""))))
                     '(nil "Urgent/Deep")))
      (should (seq-every-p (lambda (i) (plist-get i :added)) items)))))

(ert-deftest sp-fetch-inbox-arrange-orders ()
  (let ((items (sp-fetch-inbox-test--items)))
    (should (equal (mapcar (lambda (i) (plist-get i :name))
                           (sp-fetch-inbox--arrange items 'added nil))
                   '("d.pdf" "b.pdf" "c.pdf" "A.pdf")))
    (should (equal (mapcar (lambda (i) (plist-get i :name))
                           (sp-fetch-inbox--arrange items 'alphabetical nil))
                   '("A.pdf" "b.pdf" "c.pdf" "d.pdf")))))

(ert-deftest sp-fetch-inbox-arrange-groups ()
  (let ((items (sp-fetch-inbox-test--items)))
    ;; newest first: the folder of the newest item comes first
    (should (equal (mapcar (lambda (i) (plist-get i :name))
                           (sp-fetch-inbox--arrange items 'added t))
                   '("d.pdf" "c.pdf" "A.pdf" "b.pdf")))
    ;; alphabetical: root first, then the folders by name
    (should (equal (mapcar (lambda (i) (plist-get i :name))
                           (sp-fetch-inbox--arrange items 'alphabetical t))
                   '("A.pdf" "c.pdf" "d.pdf" "b.pdf")))))

(ert-deftest sp-fetch-inbox-candidates-are-unique ()
  (let ((alist (sp-fetch-inbox--candidates
                (list (list :name "x.pdf" :subdir "A") (list :name "x.pdf" :subdir "B")
                      (list :name "x.pdf" :subdir "B")))))
    (should (= (length (delete-dups (mapcar #'car alist))) 3))
    (should (equal (car (nth 0 alist)) "x.pdf"))
    (should (string-match-p "(B)" (car (nth 1 alist))))))

(ert-deftest sp-fetch-inbox-table-metadata-keeps-order ()
  (let* ((table (sp-fetch-inbox--table '(("a" . 1)) #'ignore))
         (md (funcall table "" nil 'metadata)))
    (should (eq (cdr (assq 'display-sort-function md)) 'identity))
    (should (eq (cdr (assq 'cycle-sort-function md)) 'identity))
    (should (eq (cdr (assq 'group-function md)) #'ignore))
    (should-not (assq 'group-function
                      (funcall (sp-fetch-inbox--table '(("a" . 1))) "" nil 'metadata)))))

(ert-deftest sp-fetch-inbox-select-switches-sort-and-restricts ()
  (let* ((items (sp-fetch-inbox-test--items))
         (calls nil)
         (answers (list (list 'sort "q") (list 'choose (nth 1 items)))))
    (cl-letf (((symbol-function 'sp-fetch-inbox--read)
               (lambda (shown order folder initial)
                 (push (list (length shown) order folder initial) calls)
                 (pop answers))))
      (should (eq (sp-fetch-inbox--select items) (nth 1 items)))
      (should (equal (reverse calls)
                     '((4 added nil nil) (4 alphabetical nil "q")))))
    (setq calls nil answers (list (list 'choose (car items))))
    (cl-letf (((symbol-function 'sp-fetch-inbox--read)
               (lambda (shown order folder initial)
                 (push (list (length shown) order folder initial) calls)
                 (pop answers))))
      (should (eq (sp-fetch-inbox--select items "Urgent") (car items)))
      (should (equal calls '((1 added "Urgent" nil)))))
    (should-error (sp-fetch-inbox--select items "Nope") :type 'user-error)))

(ert-deftest sp-fetch-inbox-picker-keys-throw-state ()
  (with-temp-buffer
    (cl-letf (((symbol-function 'minibufferp) (lambda (&rest _) t)))
      (insert "abc")
      (should (equal (catch 'sp-fetch-inbox--again (sp-fetch-inbox-picker-sort))
                     '(sort "abc")))
      (should (equal (catch 'sp-fetch-inbox--again (sp-fetch-inbox-picker-folder))
                     '(folder "abc")))))
  (should-error (sp-fetch-inbox-picker-sort) :type 'user-error))

(ert-deftest sp-fetch-inbox-list-script-recurses ()
  (let ((s (sp-fetch-inbox--list-script)))
    (should (string-match-p "walk(c\\[i\\]," s))
    (should (string-match-p "additionDate" s))))

(ert-deftest sp-fetch-inbox-list-script-reads-in-bulk ()
  "One Apple Event per field and group, never one per record."
  (let ((s (sp-fetch-inbox--list-script)))
    (should (string-match-p "c\\.name()" s))
    (should (string-match-p "c\\.additionDate()" s))
    (should-not (string-match-p "children()" s))
    (should-not (string-match-p "\\br\\.[a-zA-Z]+()" s))))

(ert-deftest sp-fetch-inbox-list-script-depth-option ()
  (let ((sp-fetch-inbox-devonthink-depth 0))
    (should (string-match-p "const maxDepth = 0;" (sp-fetch-inbox--list-script))))
  (let ((sp-fetch-inbox-devonthink-depth 3))
    (should (string-match-p "const maxDepth = 3;" (sp-fetch-inbox--list-script)))))

(ert-deftest sp-fetch-inbox-items-run-one-process-and-no-per-item-calls ()
  "Listing 300 records and 300 files starts exactly one osascript."
  (let* ((dir (make-temp-file "inbox" t))
         (sp-fetch-inbox-dir dir)
         (jxa 0) (procs 0)
         (text (mapconcat (lambda (n) (format "U%d\tr%d.pdf\t\t%d\tsub" n n (+ 1000 n)))
                          (number-sequence 1 300) "\n")))
    (dotimes (n 300) (write-region "" nil (expand-file-name (format "f%d.pdf" n) dir)))
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () t))
              ((symbol-function 'sp-reading--jxa) (lambda (_) (cl-incf jxa) text))
              ((symbol-function 'call-process) (lambda (&rest _) (cl-incf procs) 0))
              ((symbol-function 'process-file) (lambda (&rest _) (cl-incf procs) 0))
              ((symbol-function 'start-process) (lambda (&rest _) (cl-incf procs) nil)))
      (should (= (length (sp-fetch-inbox-items)) 600))
      (should (= jxa 1))
      (should (= procs 0)))))

(ert-deftest sp-fetch-inbox-profile-messages-steps ()
  (let ((sp-fetch-inbox-profile t) (sp-fetch-inbox-dir (make-temp-file "inbox" t))
        (log nil))
    (cl-letf (((symbol-function 'sp-fetch-inbox--dt-p) (lambda () nil))
              ((symbol-function 'message) (lambda (f &rest a) (push (apply #'format f a) log))))
      (sp-fetch-inbox-items))
    (should (seq-some (lambda (m) (string-match-p "folder scan" m)) log))
    (should (seq-some (lambda (m) (string-match-p "0 records, 0 files, 0 items" m)) log))))

(ert-deftest sp-fetch-inbox-prefix-argument-folder-with-spaces ()
  "C-u M-x sp-fetch-inbox: the folder name (a string) restricts the picker."
  (let ((items (list (list :name "a.pdf" :subdir "Texte Filosofia istoriei" :added 1)
                     (list :name "b.pdf" :subdir nil :added 2)))
        picked-folder started)
    (cl-letf (((symbol-function 'sp-fetch-inbox-items) (lambda () items))
              ((symbol-function 'completing-read)
               (lambda (prompt &rest _)
                 (if (string-prefix-p "Folder" prompt)
                     "Texte Filosofia istoriei (1)"
                   (should (string-match-p "only Texte Filosofia istoriei" prompt))
                   "a.pdf")))
              ((symbol-function 'sp-fetch-inbox--start) (lambda (item) (setq started item))))
      (should (equal (sp-fetch-inbox--read-folder items) "Texte Filosofia istoriei"))
            (sp-fetch-inbox t)
      (should (equal (plist-get started :name) "a.pdf")))))

(ert-deftest sp-fetch-inbox-merge-skips-known-files ()
  (let* ((dir (make-temp-file "inbox" t))
         (sp-fetch-inbox-dir dir)
         (a (expand-file-name "a.pdf" dir)) (b (expand-file-name "b.pdf" dir)))
    (write-region "" nil a) (write-region "" nil b)
    (let ((items (sp-fetch-inbox--merge (list (list :uuid "U" :name "a.pdf" :file a)) (list a b))))
      (should (equal (mapcar (lambda (i) (plist-get i :name)) items) '("a.pdf" "b.pdf"))))))

(ert-deftest sp-fetch-inbox-arrange-is-linear-in-folders ()
  "6000 items in 1500 folders are grouped in well under a second (was 5 s)."
  (let ((items (mapcar (lambda (n) (list :name (format "a%d.pdf" n) :added n
                                         :subdir (format "Folder %d" (mod n 1500))))
                       (number-sequence 1 6000)))
        (start (float-time)))
    (let ((out (sp-fetch-inbox--arrange items 'added t)))
      (should (= (length out) 6000))
      ;; folders stay together, newest folder first
      (should (equal (plist-get (car out) :subdir) "Folder 0")))
    (should (< (- (float-time) start) 1.5))))

