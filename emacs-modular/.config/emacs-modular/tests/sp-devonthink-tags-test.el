;;; sp-devonthink-tags-test.el --- Tests for sp-devonthink-tags -*- lexical-binding: t; -*-

(require 'ert)
(unless (boundp 'sp-cache-dir) (defvar sp-cache-dir temporary-file-directory))
(unless (boundp 'sp-var-dir) (defvar sp-var-dir temporary-file-directory))
(require 'sp-devonthink-tags)
(require 'sp-litnotes-meta)

(ert-deftest sp-devonthink-list-literal ()
  (should (equal (sp-devonthink--list-literal '("a" "b \"c\"")) "{\"a\", \"b \\\"c\\\"\"}"))
  (should (equal (sp-devonthink--list-literal nil) "{}")))

(ert-deftest sp-devonthink-merge-tags ()
  (should (equal (sp-devonthink--merge-tags '("Value") '("value" "form") 'add) '("Value" "form")))
  (should (equal (sp-devonthink--merge-tags '("a" "b") '("A") 'remove) '("b")))
  (should (equal (sp-devonthink--merge-tags '("a") '("x" "X" "y") 'set) '("x" "y")))
  (should (equal (sp-devonthink--merge-tags nil '("x") nil) '("x"))))

(ert-deftest sp-devonthink-split-tag ()
  (should (equal (sp-devonthink--split-tag "negativity,value form,New German Reading of Marx,")
                 '("negativity" "value form" "New German Reading of Marx")))
  (should (equal (sp-devonthink--split-tag " a , A,,b ") '("a" "b")))
  (should-not (sp-devonthink--split-tag ",,")))

(ert-deftest sp-devonthink-new-tags ()
  (should (equal (sp-devonthink--new-tags '("a" "B" "c") '("A" "b")) '("c"))))

(ert-deftest sp-devonthink-parse-tags ()
  (should (equal (sp-devonthink--parse-tags "U1\ta\tb\nU2\nU3\tc\n")
                 '(("U1" "a" "b") ("U2") ("U3" "c")))))

(ert-deftest sp-devonthink-set-tags-script ()
  (let ((script (sp-devonthink--set-tags-script '(("U1" "a" "b") ("U2")))))
    (should (string-match-p "set tags of (get record with uuid \"U1\") to {\"a\", \"b\"}" script))
    (should (string-match-p "to {}" script))))

(ert-deftest sp-devonthink-apply-tags-writes-only-changes ()
  (let (written (sp-devonthink-tags--known '("old")))
    (cl-letf (((symbol-function 'sp-devonthink-record-tags)
               (lambda (_) '(("U1" "a") ("U2"))))
              ((symbol-function 'sp-reading--osascript)
               (lambda (script) (setq written script) "")))
      (should (= (sp-devonthink-apply-tags '("U1" "U2") '("a") 'add) 1)))
    (should (string-match-p "\"U2\"" written))
    (should-not (string-match-p "\"U1\"" written))
    (should-not sp-devonthink-tags--known)
    (setq written nil)
    (cl-letf (((symbol-function 'sp-devonthink-record-tags) (lambda (_) '(("U1" "a"))))
              ((symbol-function 'sp-reading--osascript) (lambda (s) (setq written s) "")))
      (should (= (sp-devonthink-apply-tags '("U1") '("a") 'add) 0)))
    (should-not written)))

(ert-deftest sp-devonthink-confirm-new-marks-new-tags ()
  (let (question)
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (q) (setq question q) t)))
      (should (sp-devonthink--confirm-new '("a" "typo") '("a")))
      (should (string-match-p "typo (new)" question))
      (should-not (string-match-p "a (new)" question)))
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (_) (error "no question expected"))))
      (should (sp-devonthink--confirm-new '("a") '("a")))
      (should (sp-devonthink--confirm-new '("zzz") nil)))))

(ert-deftest sp-devonthink-split-plan-mentions-parts-and-count ()
  (let ((plan (sp-devonthink--split-plan "x,y," '("U1" "U2"))))
    (should (string-match-p "- x" plan))
    (should (string-match-p "- y" plan))
    (should (string-match-p "2 records" plan))))

(ert-deftest sp-devonthink-database-tags-survives-errors ()
  (let ((sp-devonthink-tags--known nil))
    (cl-letf (((symbol-function 'sp-reading--osascript) (lambda (_) (error "boom"))))
      (should-not (sp-devonthink-database-tags t)))
    (cl-letf (((symbol-function 'sp-reading--osascript) (lambda (_) "a\nb")))
      (should (equal (sp-devonthink-database-tags t) '("a" "b"))))))

(ert-deftest sp-devonthink-tags-tag-note-asks-before-tagging-the-parent ()
  (let (applied)
    (cl-letf (((symbol-function 'sp-devonthink-note-record-uuid)
               (lambda (&optional action)
                 (unless (equal action "tag") (error "wrong action"))
                 "U-PARENT"))
              ((symbol-function 'sp-devonthink-apply-tags)
               (lambda (uuids tags mode) (setq applied (list uuids tags mode)) 1))
              ((symbol-function 'sp-devonthink--mirror-tags) #'ignore)
              ((symbol-function 'message) #'ignore))
      (sp-devonthink-tag-note '("a") nil)
      (should (equal applied '(("U-PARENT") ("a") add))))
    (cl-letf (((symbol-function 'sp-devonthink-note-record-uuid) (lambda (&rest _) nil)))
      (should-error (sp-devonthink-tag-note '("a") nil) :type 'user-error))))

(defconst sp-devonthink-tags-test--note
  ":PROPERTIES:\n:ID: abc\n:ROAM_REFS: @key\n:END:\n#+title: Key\n\n- pub-title :: A title\n- pub-year :: 2020\n\n* Notes\nbody\n")

(ert-deftest sp-devonthink-keywords-value-format ()
  (should (equal (sp-devonthink-keywords-value '("negativity" "value form" "Money"))
                 "negativity, value form, Money"))
  (should (equal (sp-devonthink-keywords-value '("a" "A" "b,c,")) "a, b, c"))
  (should (equal (sp-devonthink-keywords-value nil) "")))

(ert-deftest sp-devonthink-write-keywords-adds-then-replaces-the-line ()
  (with-temp-buffer
    (insert sp-devonthink-tags-test--note)
    (should (equal (sp-devonthink-write-keywords '("a" "b c")) "a, b c"))
    (should (string-match-p "^- keywords :: a, b c$" (buffer-string)))
    (should (string-match-p "^- pub-year :: 2020\n- keywords :: a, b c\n" (buffer-string)))
    (sp-devonthink-write-keywords '("z"))
    (should (= 1 (how-many "^- keywords ::" (point-min) (point-max))))
    (should (string-match-p "^- keywords :: z$" (buffer-string)))
    (sp-devonthink-write-keywords nil)
    (should (string-match-p "^- keywords :: *$" (buffer-string)))
    (should (string-match-p "^\\* Notes\nbody" (buffer-string)))))

(ert-deftest sp-devonthink-write-keywords-respects-the-option ()
  (with-temp-buffer
    (insert sp-devonthink-tags-test--note)
    (let ((sp-devonthink-keywords-key nil))
      (should-not (sp-devonthink-write-keywords '("a"))))
    (should-not (string-match-p "keywords" (buffer-string)))
    (let ((sp-devonthink-keywords-key "tags-mirror"))
      (sp-devonthink-write-keywords '("a")))
    (should (string-match-p "^- tags-mirror :: a$" (buffer-string)))))

(ert-deftest sp-devonthink-mirror-tags-reads-the-record-and-writes-the-line ()
  (with-temp-buffer
    (insert sp-devonthink-tags-test--note)
    (cl-letf (((symbol-function 'sp-devonthink--own-record-p) (lambda () t))
              ((symbol-function 'sp-devonthink-record-tags)
               (lambda (uuids) (should (equal uuids '("U1"))) '(("U1" "x" "y")))))
      (sp-devonthink--mirror-tags "U1"))
    (should (string-match-p "^- keywords :: x, y$" (buffer-string)))))

(ert-deftest sp-devonthink-mirror-tags-skips-a-chapter-using-its-parents-record ()
  (with-temp-buffer
    (insert sp-devonthink-tags-test--note)
    (cl-letf (((symbol-function 'sp-devonthink--own-record-p) (lambda () nil))
              ((symbol-function 'sp-devonthink-record-tags)
               (lambda (_) (error "must not read the tags")))
              ((symbol-function 'message) #'ignore))
      (should-not (sp-devonthink--mirror-tags "U-PARENT")))
    (should-not (string-match-p "keywords" (buffer-string)))))

(ert-deftest sp-devonthink-own-record-p-distinguishes-parent-records ()
  (cl-letf (((symbol-function 'sp-devonthink-note-uuid) (lambda (&rest _) nil))
            ((symbol-function 'sp-devonthink-note-citekey) (lambda (&rest _) "key")))
    (cl-letf (((symbol-function 'sp-devonthink-record) (lambda (_) '(:uuid "U" :supplier "key"))))
      (should (sp-devonthink--own-record-p)))
    (cl-letf (((symbol-function 'sp-devonthink-record)
               (lambda (_) '(:uuid "U" :supplier "p" :via "p"))))
      (should-not (sp-devonthink--own-record-p))))
  (cl-letf (((symbol-function 'sp-devonthink-note-uuid) (lambda (&rest _) "U-KW")))
    (should (sp-devonthink--own-record-p))))

(ert-deftest sp-devonthink-keywords-sync-refuses-a-chapter ()
  (cl-letf (((symbol-function 'sp-devonthink-note-uuid) (lambda (&rest _) nil))
            ((symbol-function 'sp-devonthink-note-citekey) (lambda (&rest _) "ch"))
            ((symbol-function 'sp-devonthink-record)
             (lambda (_) '(:uuid "U" :supplier "p" :via "p"))))
    (should-error (sp-devonthink-keywords-sync) :type 'user-error))
  (cl-letf (((symbol-function 'sp-devonthink-note-uuid) (lambda (&rest _) nil))
            ((symbol-function 'sp-devonthink-note-citekey) (lambda (&rest _) nil)))
    (should-error (sp-devonthink-keywords-sync) :type 'user-error)))

(ert-deftest sp-devonthink-tag-note-mirrors-the-tags-afterwards ()
  (let (mirrored)
    (cl-letf (((symbol-function 'sp-devonthink-note-record-uuid) (lambda (&rest _) "U1"))
              ((symbol-function 'sp-devonthink-apply-tags) (lambda (&rest _) 1))
              ((symbol-function 'sp-devonthink--mirror-tags) (lambda (uuid) (setq mirrored uuid)))
              ((symbol-function 'message) #'ignore))
      (sp-devonthink-tag-note '("a") nil)
      (should (equal mirrored "U1")))))

(provide 'sp-devonthink-tags-test)
;;; sp-devonthink-tags-test.el ends here

;;; Browser tags in litnote and BibTeX

(ert-deftest sp-devonthink-merge-keywords ()
  (should (equal (sp-devonthink--merge-keywords nil '("a" "b")) "a, b"))
  (should (equal (sp-devonthink--merge-keywords "a, B" '("b" "c")) "a, B, c"))
  (should (equal (sp-devonthink--merge-keywords "a; b" '("c")) "a; b; c"))
  (should-not (sp-devonthink--merge-keywords "a, b" '("A")))
  (should (equal (sp-devonthink--merge-keywords "x" '("p,q")) "x, p, q")))

(defun sp-devonthink-test--bib (text key tags)
  "Run `sp-devonthink--bib-set-keywords' on TEXT; return (RESULT . NEW-TEXT)."
  (with-temp-buffer
    (insert text)
    (delay-mode-hooks (bibtex-mode))
    (let ((result (sp-devonthink--bib-set-keywords key tags)))
      (cons result (buffer-string)))))

(ert-deftest sp-devonthink-bib-set-keywords-existing ()
  (let ((out (sp-devonthink-test--bib
              "@book{k1,\n  title = {T},\n  keywords = {a, b},\n  year = {2020}\n}\n@book{k2,\n  keywords = {z}\n}\n"
              "k1" '("c" "A"))))
    (should (equal (car out) "a, b, c"))
    (should (string-match-p "keywords = {a, b, c},\n  year" (cdr out)))
    (should (string-match-p "@book{k2,\n  keywords = {z}\n}" (cdr out)))))

(ert-deftest sp-devonthink-bib-set-keywords-missing-field ()
  (dolist (text '("@book{k1,\n  title = {T}\n}\n" "@book{k1,\n  title = {T},\n}\n"))
    (let ((out (sp-devonthink-test--bib text "k1" '("a" "b"))))
      (should (equal (car out) "a, b"))
      (should (string-match-p "title = {T},\n  keywords = {a, b}" (cdr out)))
      (should (string-match-p "}\n\\'" (cdr out))))))

(ert-deftest sp-devonthink-bib-set-keywords-nothing-to-do ()
  (let ((out (sp-devonthink-test--bib "@book{k1,\n  keywords = {a}\n}\n" "k1" '("a"))))
    (should-not (car out))
    (should (equal (cdr out) "@book{k1,\n  keywords = {a}\n}\n")))
  (should-not (car (sp-devonthink-test--bib "@book{k1,\n  title = {T}\n}\n" "other" '("a")))))

(ert-deftest sp-devonthink-write-bib-keywords-file ()
  (let ((file (make-temp-file "sp-dt" nil ".bib" "@book{k1,\n  title = {T}\n}\n")))
    (unwind-protect
        (progn
          (should (equal (sp-devonthink--write-bib-keywords file '(("k1" "a"))) '("k1")))
          (should (string-match-p "keywords = {a}" (with-temp-buffer (insert-file-contents file) (buffer-string))))
          (should-not (find-buffer-visiting file))
          (with-current-buffer (find-file-noselect file)
            (insert " ")
            (should (eq (sp-devonthink--write-bib-keywords file '(("k1" "b"))) 'unsaved))
            (set-buffer-modified-p nil)
            (kill-buffer)))
      (delete-file file))))

(ert-deftest sp-devonthink-mirror-record-tags ()
  (let* ((note (make-temp-file "sp-dt" nil ".org" "* Note\n"))
         (bib (make-temp-file "sp-dt" nil ".bib" "@book{k1,\n  title = {T}\n}\n"))
         (sp-devonthink-keywords-key "keywords")
         question put)
    (unwind-protect
        (cl-letf (((symbol-function 'sp-devonthink--key-litnote)
                   (lambda (key) (and (equal key "k1") note)))
                  ((symbol-function 'sp-devonthink--key-bib-file)
                   (lambda (key) (and (equal key "k1") bib)))
                  ((symbol-function 'sp-devonthink-record-tags)
                   (lambda (_) '(("U1" "a" "b"))))
                  ((symbol-function 'sp-devonthink-write-keywords)
                   (lambda (tags) (setq put tags) (insert "kw")))
                  ((symbol-function 'y-or-n-p) (lambda (q) (setq question q) t)))
          ;; U2 is an inbox record: neither a litnote nor an entry, skipped.
          (should (= (sp-devonthink-mirror-record-tags '(("U1" . "k1") ("U2" . "Inbox doc")) '("b")) 1))
          (should (equal put '("a" "b")))
          (should (string-match-p "BibTeX keywords of k1" question))
          (should (string-match-p "keywords = {b}" (with-temp-buffer (insert-file-contents bib) (buffer-string))))
          (should (string-match-p "kw" (with-temp-buffer (insert-file-contents note) (buffer-string)))))
      (delete-file note) (delete-file bib))))

(ert-deftest sp-devonthink-mirror-record-tags-declined-and-off ()
  (let ((bib (make-temp-file "sp-dt" nil ".bib" "@book{k1,\n  title = {T}\n}\n")))
    (unwind-protect
        (cl-letf (((symbol-function 'sp-devonthink--key-litnote) (lambda (_) nil))
                  ((symbol-function 'sp-devonthink--key-bib-file) (lambda (_) bib)))
          (cl-letf (((symbol-function 'y-or-n-p) (lambda (_) nil)))
            (sp-devonthink-mirror-record-tags '(("U1" . "k1")) '("b")))
          (should-not (string-match-p "keywords" (with-temp-buffer (insert-file-contents bib) (buffer-string))))
          (cl-letf (((symbol-function 'y-or-n-p) (lambda (_) (error "no question"))))
            (let ((sp-devonthink-bibtex-keywords nil))
              (should (= (sp-devonthink-mirror-record-tags '(("U1" . "k1")) '("b")) 1)))))
      (delete-file bib))))

(ert-deftest sp-devonthink-fill-keywords ()
  (let ((sp-devonthink-keywords-key "keywords") (sp-devonthink-keywords-on-fill t)
        (sp-litnotes-meta--index nil) (written nil))
    (cl-letf (((symbol-value 'system-type) 'darwin)
              ((symbol-function 'sp-litnotes-meta--has-value-p) (lambda (_) nil))
              ((symbol-function 'sp-devonthink-record) (lambda (_) '(:uuid "U1" :supplier "k1")))
              ((symbol-function 'sp-devonthink-record-tags) (lambda (_) '(("U1" "a"))))
              ((symbol-function 'sp-devonthink-write-keywords) (lambda (tags) (setq written tags))))
      (should (equal (sp-devonthink--fill-keywords "k1") "keywords"))
      (should (equal written '("a")))
      (setq written nil)
      ;; batch fill, option off, parent's record, existing value, no tags: nothing written
      (let ((sp-litnotes-meta--index (make-hash-table))) (should-not (sp-devonthink--fill-keywords "k1")))
      (let ((sp-devonthink-keywords-on-fill nil)) (should-not (sp-devonthink--fill-keywords "k1")))
      (cl-letf (((symbol-function 'sp-devonthink-record) (lambda (_) '(:uuid "U1" :via "p"))))
        (should-not (sp-devonthink--fill-keywords "k1")))
      (cl-letf (((symbol-function 'sp-litnotes-meta--has-value-p) (lambda (_) t)))
        (should-not (sp-devonthink--fill-keywords "k1")))
      (cl-letf (((symbol-function 'sp-devonthink-record-tags) (lambda (_) '(("U1")))))
        (should-not (sp-devonthink--fill-keywords "k1")))
      (should-not written))
    ;; no record (inbox): quiet
    (cl-letf (((symbol-value 'system-type) 'darwin)
              ((symbol-function 'sp-litnotes-meta--has-value-p) (lambda (_) nil))
              ((symbol-function 'sp-devonthink-record) (lambda (_) (error "boom"))))
      (should-not (sp-devonthink--fill-keywords "Inbox doc")))))
