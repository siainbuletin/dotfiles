;;; sp-devonthink-tags-test.el --- Tests for sp-devonthink-tags -*- lexical-binding: t; -*-

(require 'ert)
(require 'sp-devonthink-tags)

(ert-deftest sp-devonthink-list-literal ()
  (should (equal (sp-devonthink--list-literal '("a" "b \"c\"")) "{\"a\", \"b \\\"c\\\"\"}"))
  (should (equal (sp-devonthink--list-literal nil) "{}")))

(ert-deftest sp-devonthink-merge-tags ()
  (should (equal (sp-devonthink--merge-tags '("Value") '("value" "form") 'add) '("Value" "form")))
  (should (equal (sp-devonthink--merge-tags '("a" "b") '("A") 'remove) '("b")))
  (should (equal (sp-devonthink--merge-tags '("a") '("x" "X" "y") 'set) '("x" "y")))
  (should (equal (sp-devonthink--merge-tags nil '("x") nil) '("x"))))

(ert-deftest sp-devonthink-split-tag ()
  (should (equal (sp-devonthink--split-tag "negativity,value form,New German Reading of Marx,")
                 '("negativity" "value form" "New German Reading of Marx")))
  (should (equal (sp-devonthink--split-tag " a , A,,b ") '("a" "b")))
  (should-not (sp-devonthink--split-tag ",,")))

(ert-deftest sp-devonthink-new-tags ()
  (should (equal (sp-devonthink--new-tags '("a" "B" "c") '("A" "b")) '("c"))))

(ert-deftest sp-devonthink-parse-tags ()
  (should (equal (sp-devonthink--parse-tags "U1\ta\tb\nU2\nU3\tc\n")
                 '(("U1" "a" "b") ("U2") ("U3" "c")))))

(ert-deftest sp-devonthink-set-tags-script ()
  (let ((script (sp-devonthink--set-tags-script '(("U1" "a" "b") ("U2")))))
    (should (string-match-p "set tags of (get record with uuid \"U1\") to {\"a\", \"b\"}" script))
    (should (string-match-p "to {}" script))))

(ert-deftest sp-devonthink-apply-tags-writes-only-changes ()
  (let (written (sp-devonthink-tags--known '("old")))
    (cl-letf (((symbol-function 'sp-devonthink-record-tags)
               (lambda (_) '(("U1" "a") ("U2"))))
              ((symbol-function 'sp-reading--osascript)
               (lambda (script) (setq written script) "")))
      (should (= (sp-devonthink-apply-tags '("U1" "U2") '("a") 'add) 1)))
    (should (string-match-p "\"U2\"" written))
    (should-not (string-match-p "\"U1\"" written))
    (should-not sp-devonthink-tags--known)
    (setq written nil)
    (cl-letf (((symbol-function 'sp-devonthink-record-tags) (lambda (_) '(("U1" "a"))))
              ((symbol-function 'sp-reading--osascript) (lambda (s) (setq written s) "")))
      (should (= (sp-devonthink-apply-tags '("U1") '("a") 'add) 0)))
    (should-not written)))

(ert-deftest sp-devonthink-confirm-new-marks-new-tags ()
  (let (question)
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (q) (setq question q) t)))
      (should (sp-devonthink--confirm-new '("a" "typo") '("a")))
      (should (string-match-p "typo (new)" question))
      (should-not (string-match-p "a (new)" question)))
    (cl-letf (((symbol-function 'y-or-n-p) (lambda (_) (error "no question expected"))))
      (should (sp-devonthink--confirm-new '("a") '("a")))
      (should (sp-devonthink--confirm-new '("zzz") nil)))))

(ert-deftest sp-devonthink-split-plan-mentions-parts-and-count ()
  (let ((plan (sp-devonthink--split-plan "x,y," '("U1" "U2"))))
    (should (string-match-p "- x" plan))
    (should (string-match-p "- y" plan))
    (should (string-match-p "2 records" plan))))

(ert-deftest sp-devonthink-database-tags-survives-errors ()
  (let ((sp-devonthink-tags--known nil))
    (cl-letf (((symbol-function 'sp-reading--osascript) (lambda (_) (error "boom"))))
      (should-not (sp-devonthink-database-tags t)))
    (cl-letf (((symbol-function 'sp-reading--osascript) (lambda (_) "a\nb")))
      (should (equal (sp-devonthink-database-tags t) '("a" "b"))))))

(ert-deftest sp-devonthink-tags-tag-note-asks-before-tagging-the-parent ()
  (let (applied)
    (cl-letf (((symbol-function 'sp-devonthink-note-record-uuid)
               (lambda (&optional action)
                 (unless (equal action "tag") (error "wrong action"))
                 "U-PARENT"))
              ((symbol-function 'sp-devonthink-apply-tags)
               (lambda (uuids tags mode) (setq applied (list uuids tags mode)) 1))
              ((symbol-function 'message) #'ignore))
      (sp-devonthink-tag-note '("a") nil)
      (should (equal applied '(("U-PARENT") ("a") add))))
    (cl-letf (((symbol-function 'sp-devonthink-note-record-uuid) (lambda (&rest _) nil)))
      (should-error (sp-devonthink-tag-note '("a") nil) :type 'user-error))))

(provide 'sp-devonthink-tags-test)
;;; sp-devonthink-tags-test.el ends here
