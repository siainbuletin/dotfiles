;;; sp-reading-test.el --- Tests for sp-reading -*- lexical-binding: t; -*-

(require 'ert)
(require 'sp-reading)

(ert-deftest sp-reading-test-quote ()
  (should (equal (sp-reading--quote "a\"b\\c") "\"a\\\"b\\\\c\"")))

(ert-deftest sp-reading-test-parse-listing ()
  (let ((table (sp-reading--parse-listing
                "AAA-1\tsmith2020attention.pdf\nBBB-2\tnotes.txt\nCCC-3\tOther.PDF\nbad line\n")))
    (should (= (hash-table-count table) 2))
    (should (equal (gethash "smith2020attention" table) "AAA-1"))
    (should (equal (gethash "Other" table) "CCC-3"))))

(ert-deftest sp-reading-test-url ()
  (should (equal (sp-reading--url "U-1") "x-devonthink-item://U-1"))
  (should (equal (sp-reading--url "U-1" 5) "x-devonthink-item://U-1?page=5")))

(ert-deftest sp-reading-test-uuid-uses-cache-then-asks ()
  (let ((sp-reading-index (make-hash-table :test 'equal))
        (calls 0))
    (puthash "known" "U-KNOWN" sp-reading-index)
    (cl-letf (((symbol-function 'sp-reading--jxa)
               (lambda (script)
                 (if (string-match-p "app.search" script)
                     (progn (cl-incf calls)
                            (if (string-match-p "newkey" script) "U-NEW" ""))
                   ""))))
      (should (equal (sp-reading-uuid "known") "U-KNOWN"))
      (should (= calls 0))
      (should (equal (sp-reading-uuid "newkey") "U-NEW"))
      (should (equal (sp-reading-uuid "newkey") "U-NEW"))
      (should (= calls 1))
      (should-not (sp-reading-uuid "absent")))))

(ert-deftest sp-reading-test-open-found ()
  (let ((sp-reading-index (make-hash-table :test 'equal)) opened)
    (puthash "k" "U-9" sp-reading-index)
    (cl-letf (((symbol-function 'sp-reading--open-url) (lambda (u) (setq opened u))))
      (sp-reading-open "k" 3)
      (should (equal opened "x-devonthink-item://U-9?page=3")))))

(ert-deftest sp-reading-test-open-index-and-preview ()
  (let ((sp-reading-index (make-hash-table :test 'equal))
        (file (make-temp-file "sp-reading" nil ".pdf"))
        opened indexed called)
    (unwind-protect
        (cl-letf (((symbol-function 'sp-reading--jxa) (lambda (_) ""))
                  ((symbol-function 'sp-reading--osascript)
                   (lambda (script)
                     (if (string-match-p "index path" script)
                         (progn (setq indexed script) "U-NEW")
                       "")))
                  ((symbol-function 'sp-reading--pdf) (lambda (_) file))
                  ((symbol-function 'sp-reading--open-url) (lambda (u) (setq opened u)))
                  ((symbol-function 'sp-reading--run)
                   (lambda (&rest args) (setq called args) 0)))
          (cl-letf (((symbol-function 'sp-reading--ask) (lambda (&rest _) "Index in DEVONthink")))
            (sp-reading-open "k")
            (should (equal opened "x-devonthink-item://U-NEW"))
            (should (string-match-p (regexp-quote file) indexed))
            (should (string-match-p "name of theRecord to \"k.pdf\"" indexed))
            (should (equal (gethash "k" sp-reading-index) "U-NEW")))
          (clrhash sp-reading-index)
          (cl-letf (((symbol-function 'sp-reading--ask) (lambda (&rest _) "Open in Preview")))
            (sp-reading-open "k")
            (should (equal (car called) "open"))
            (should (equal (car (last called)) file))))
      (delete-file file))))

(ert-deftest sp-reading-test-no-pdf ()
  (let ((sp-reading-index (make-hash-table :test 'equal)))
    (cl-letf (((symbol-function 'sp-reading--jxa) (lambda (_) ""))
              ((symbol-function 'sp-reading--pdf) (lambda (_) nil)))
      (should-not (sp-reading-open "none")))))


(ert-deftest sp-reading-test-listing-is-bulk-jxa-and-refresh-parses-it ()
  (let ((script (sp-reading--listing-script)))
    (should (string-match-p "app.databases.byName(\"literature\").contents" script))
    (should (string-match-p "c.uuid()" script))
    (should-not (string-match-p "every item" script)))
  (let ((sp-reading-index nil))
    (cl-letf (((symbol-function 'sp-reading--jxa)
               (lambda (_) "U-1\tsmith-2017-x.pdf\nU-2\tother-2000-y.pdf")))
      (sp-reading-refresh))
    (should (equal (gethash "smith-2017-x" sp-reading-index) "U-1"))
    (should (= (hash-table-count sp-reading-index) 2))))

(ert-deftest sp-reading-test-listing-filters-on-path-and-diagnose ()
  (let ((script (sp-reading--listing-script)))
    (should (string-match-p "c.path()" script))
    (should (string-match-p "paths\\[i\\].toLowerCase().endsWith" script))
    (should (string-match-p "names\\[i\\] [+] \"[.]pdf\"" script)))
  (should (string-match-p "pdf_by_path" (sp-reading--diagnose-script)))
  (let ((sp-reading-index nil) message-text)
    (cl-letf (((symbol-function 'sp-reading--jxa) (lambda (_) ""))
              ((symbol-function 'message)
               (lambda (fmt &rest args) (setq message-text (apply #'format fmt args)))))
      (sp-reading-refresh))
    (should (string-match-p "0 PDFs in literature; run M-x sp-reading-diagnose" message-text)))
  (cl-letf (((symbol-function 'sp-reading--jxa) (lambda (_) "{\"records\": 3}"))
            ((symbol-function 'display-buffer) #'ignore))
    (should (string-match-p "records" (sp-reading-diagnose)))
    (with-current-buffer "*sp-reading diagnose*"
      (should (string-match-p "\"records\": 3" (buffer-string))))))

(ert-deftest sp-reading-test-lookup-accepts-name-without-extension-and-path ()
  (let ((script (sp-reading--lookup-script "arthur-2004-value-negat")))
    (should (string-match-p "\"arthur-2004-value-negat\".toLowerCase()" script))
    (should (string-match-p "stem(r.name()) === key" script))
    (should (string-match-p "base(r.path()) === key" script))
    (should-not (string-match-p "tell application" script))))

(ert-deftest sp-reading-test-uuid-falls-back-to-full-refresh ()
  (let ((sp-reading-index nil) (calls 0))
    (cl-letf (((symbol-function 'sp-reading--jxa)
               (lambda (script)
                 (cl-incf calls)
                 (if (string-match-p "app.search" script)
                     ""
                   "U-9\tarthur-2004-value-negat.pdf"))))
      (should (equal (sp-reading-uuid "arthur-2004-value-negat") "U-9"))
      (should (= calls 2))
      (should (null (sp-reading-uuid "missing-2000-x"))))))

(ert-deftest sp-reading-test-uuid-uses-direct-lookup-first ()
  (let ((sp-reading-index nil))
    (cl-letf (((symbol-function 'sp-reading--jxa) (lambda (_) "U-5\n")))
      (should (equal (sp-reading-uuid "a-2001-b") "U-5"))
      (should (equal (gethash "a-2001-b" sp-reading-index) "U-5")))))

(ert-deftest sp-reading-test-open-follows-crossref-parent ()
  (let ((sp-reading-index (make-hash-table :test 'equal)) opened)
    (puthash "parent-2000-b" "U-PARENT" sp-reading-index)
    (cl-letf (((symbol-function 'sp-reading--jxa) (lambda (_) ""))
              ((symbol-function 'sp-reading-refresh) (lambda () sp-reading-index))
              ((symbol-function 'sp-devonthink-resolve)
               (lambda (k) (and (equal k "child-2001-x")
                                (list :uuid "U-PARENT" :via "parent-2000-b" :page 47 :note "n"))))
              ((symbol-function 'sp-reading--open-url) (lambda (u) (setq opened u)))
              ((symbol-function 'message) #'ignore))
      (sp-reading-open "child-2001-x")
      (should (equal opened "x-devonthink-item://U-PARENT?page=46"))
      (sp-reading-open "child-2001-x" 9)
      (should (equal opened "x-devonthink-item://U-PARENT?page=9")))))

;;; sp-reading-test.el ends here
