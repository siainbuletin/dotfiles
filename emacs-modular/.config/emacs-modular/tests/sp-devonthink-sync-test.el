;;; sp-devonthink-sync-test.el --- Tests for sp-devonthink-sync -*- lexical-binding: t; -*-

(require 'ert)
(require 'sp-devonthink-sync)

(defconst sp-devonthink-sync-test--u1 "11111111-2222-3333-4444-555555555555")
(defconst sp-devonthink-sync-test--u2 "AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE")

(defun sp-devonthink-sync-test--records ()
  (let ((h (make-hash-table :test 'equal)))
    (puthash "a-2000-x" sp-devonthink-sync-test--u1 h)
    (puthash "b-2001-y" sp-devonthink-sync-test--u2 h)
    (puthash "c-2002-z" "CCCCCCCC-2222-3333-4444-555555555555" h)
    h))

(defun sp-devonthink-sync-test--note (key &optional uuid id)
  (list :file (format "/n/%s.org" key) :key key :uuid uuid :id id))

(ert-deftest sp-devonthink-sync-compare-sections ()
  (let* ((notes (list (sp-devonthink-sync-test--note "a-2000-x" sp-devonthink-sync-test--u1 "ID1")
                      (sp-devonthink-sync-test--note "b-2001-y" "99999999-2222-3333-4444-555555555555")
                      (sp-devonthink-sync-test--note "nopdf-1999-q")
                      (sp-devonthink-sync-test--note "d-2003-w" sp-devonthink-sync-test--u1)))
         (records (sp-devonthink-sync-test--records))
         (bib (make-hash-table :test 'equal)))
    (puthash "a-2000-x" t bib)
    (puthash "b-2001-y" t bib)
    (let ((r (sp-devonthink-sync--compare notes records bib)))
      (should (equal (plist-get r :pdf-no-note) '("c-2002-z")))
      (should (equal (mapcar (lambda (n) (plist-get n :key)) (plist-get r :note-no-pdf))
                     '("nopdf-1999-q" "d-2003-w")))
      (should (equal (plist-get r :pdf-not-bib) '("c-2002-z")))
      (should (equal (mapcar (lambda (n) (plist-get n :key)) (plist-get r :dead)) '("b-2001-y")))
      (should (equal (plist-get r :differs) nil))
      (should-not (plist-get r :backfill)))
    (let ((r (sp-devonthink-sync--compare
              (list (sp-devonthink-sync-test--note "a-2000-x")
                    (sp-devonthink-sync-test--note "b-2001-y" sp-devonthink-sync-test--u1))
              records)))
      (should (equal (mapcar (lambda (n) (plist-get n :key)) (plist-get r :backfill)) '("a-2000-x")))
      (should (equal (mapcar (lambda (n) (plist-get n :key)) (plist-get r :differs)) '("b-2001-y")))
      (should-not (plist-get r :pdf-not-bib)))))

(ert-deftest sp-devonthink-sync-read-and-scan ()
  (let ((dir (make-temp-file "dtsync" t)))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "a.org" dir)
            (insert ":PROPERTIES:\n:ID: ID-A\n:ROAM_REFS: @a-2000-x\n:END:\n#+title: A\n"))
          (with-temp-file (expand-file-name "b.org" dir)
            (insert "#+title: B\n#+reference: b-2001-y\n#+devonthink: " sp-devonthink-sync-test--u1 "\n"))
          (with-temp-file (expand-file-name "c.org" dir) (insert "#+title: no key\n"))
          (let ((notes (sort (sp-devonthink-sync--scan dir)
                             (lambda (x y) (string< (plist-get x :key) (plist-get y :key))))))
            (should (= (length notes) 2))
            (should (equal (plist-get (car notes) :id) "ID-A"))
            (should-not (plist-get (car notes) :uuid))
            (should (equal (plist-get (cadr notes) :uuid) sp-devonthink-sync-test--u1))))
      (delete-directory dir t))))

(ert-deftest sp-devonthink-sync-write-keyword-and-backup ()
  (let* ((dir (make-temp-file "dtsync" t))
         (file (expand-file-name "a.org" dir))
         (backup (expand-file-name "bk/" dir)))
    (unwind-protect
        (progn
          (with-temp-file file (insert "#+title: A\n#+reference: a-2000-x\n\n* H\n"))
          (sp-devonthink-sync--backup file backup)
          (should (sp-devonthink-sync--write-keyword file sp-devonthink-sync-test--u1))
          (should-not (sp-devonthink-sync--write-keyword file sp-devonthink-sync-test--u2))
          (with-temp-buffer
            (insert-file-contents file)
            (should (equal (buffer-string)
                           (format "#+title: A\n#+devonthink: %s\n#+reference: a-2000-x\n\n* H\n"
                                   sp-devonthink-sync-test--u1))))
          (with-temp-buffer
            (insert-file-contents (expand-file-name "a.org" backup))
            (should-not (string-match-p "devonthink" (buffer-string)))))
      (delete-directory dir t))))

(ert-deftest sp-devonthink-sync-backfill-asks-and-skips-unsaved ()
  (let* ((dir (make-temp-file "dtsync" t))
         (sp-devonthink-sync-directory dir)
         (sp-devonthink-sync-backup-directory (expand-file-name "bk/" dir))
         (a (expand-file-name "a.org" dir))
         (b (expand-file-name "b.org" dir)))
    (unwind-protect
        (progn
          (with-temp-file a (insert "#+title: A\n#+reference: a-2000-x\n"))
          (with-temp-file b (insert "#+title: B\n#+reference: b-2001-y\n"))
          (let ((buf (find-file-noselect b)))
            (with-current-buffer buf (fundamental-mode) (insert "unsaved"))
            (cl-letf (((symbol-function 'sp-devonthink-sync--records) #'sp-devonthink-sync-test--records)
                      ((symbol-function 'display-buffer) #'ignore)
                      ((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
              (sp-devonthink-sync-backfill)
              (with-temp-buffer (insert-file-contents a)
                                (should-not (string-match-p "#\\+devonthink" (buffer-string)))))
            (cl-letf (((symbol-function 'sp-devonthink-sync--records) #'sp-devonthink-sync-test--records)
                      ((symbol-function 'display-buffer) #'ignore)
                      ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (sp-devonthink-sync-backfill))
            (with-temp-buffer (insert-file-contents a)
                              (should (string-match-p "#\\+devonthink: 11111111" (buffer-string))))
            (with-temp-buffer (insert-file-contents b)
                              (should-not (string-match-p "#\\+devonthink" (buffer-string))))
            (with-current-buffer buf (set-buffer-modified-p nil))
            (kill-buffer buf)))
      (delete-directory dir t))))

(ert-deftest sp-devonthink-sync-report-text ()
  (let ((text (sp-devonthink-sync--report-text
               (sp-devonthink-sync--compare
                (list (sp-devonthink-sync-test--note "a-2000-x")) (sp-devonthink-sync-test--records))
               nil)))
    (should (string-match-p "\\* PDFs with no litnote (2)" text))
    (should (string-match-p "\\* To backfill (1)\n- \\[\\[file:/n/a-2000-x.org\\]\\[a-2000-x\\]\\]" text))
    (should (string-match-p "could not be read" text))))

(ert-deftest sp-devonthink-sync-link-plan-and-scripts ()
  (let* ((records (sp-devonthink-sync-test--records))
         (plan (sp-devonthink-sync--link-plan
                (list (sp-devonthink-sync-test--note "a-2000-x" (downcase sp-devonthink-sync-test--u1) "ID1")
                      (sp-devonthink-sync-test--note "b-2001-y" sp-devonthink-sync-test--u2)
                      (sp-devonthink-sync-test--note "q" "00000000-0000-0000-0000-000000000000" "ID3"))
                records)))
    (should (equal plan (list (cons (downcase sp-devonthink-sync-test--u1) "ID1"))))
    (let ((script (sp-devonthink-sync--link-script plan)))
      (should (string-match-p "add custom meta data \"org-protocol://devonthink-note\\?id=ID1\" for \"litnote\"" script))
      (should (string-match-p "get record with uuid \"11111111" script)))
    (should (string-match-p "for \"litnote\" to r" (sp-devonthink-sync--probe-script "U")))))

(ert-deftest sp-devonthink-protocol-note-opens-by-id ()
  (require 'org-id)
  (let (opened)
    (cl-letf (((symbol-function 'org-id-open) (lambda (id _) (setq opened id))))
      (sp-devonthink-protocol-note '(:id "ID1"))
      (should (equal opened "ID1"))
      (sp-devonthink-protocol-note "id=ID2")
      (should (equal opened "ID2"))
      (should-error (sp-devonthink-protocol-note '(:x 1)) :type 'user-error))))

(ert-deftest sp-devonthink-sync-compare-follows-crossref ()
  (let* ((parent-of (lambda (key) (cdr (assoc key '(("chap-2005-q" . "a-2000-x")
                                                    ("chap-2006-r" . "gone-1990-g"))))))
         (notes (list (sp-devonthink-sync-test--note "chap-2005-q")
                      (sp-devonthink-sync-test--note "chap-2006-r")
                      (sp-devonthink-sync-test--note "nopdf-1999-q")))
         (r (sp-devonthink-sync--compare notes (sp-devonthink-sync-test--records) nil parent-of))
         (keys (lambda (section) (mapcar (lambda (n) (plist-get n :key)) (plist-get r section)))))
    (should (equal (funcall keys :via-parent) '("chap-2005-q")))
    (should (equal (funcall keys :backfill-parent) '("chap-2005-q")))
    (should (equal (plist-get (car (plist-get r :via-parent)) :via) "a-2000-x"))
    (should (equal (funcall keys :note-no-pdf) '("chap-2006-r" "nopdf-1999-q")))
    (should-not (plist-get r :backfill))
    (should (string-match-p "Covered by the record of the crossref parent (1)"
                            (sp-devonthink-sync--report-text r nil)))))

(ert-deftest sp-devonthink-sync-backfill-asks-before-writing-the-parents-uuid ()
  (let* ((dir (make-temp-file "dtsync" t))
         (sp-devonthink-sync-directory dir)
         (sp-devonthink-sync-backup-directory (expand-file-name "bk/" dir))
         (c (expand-file-name "c.org" dir))
         prompts)
    (unwind-protect
        (progn
          (with-temp-file c (insert "#+title: C\n#+reference: chap-2005-q\n"))
          (cl-letf (((symbol-function 'sp-devonthink-sync--records) #'sp-devonthink-sync-test--records)
                    ((symbol-function 'sp-devonthink--parent-key)
                     (lambda (key) (and (equal key "chap-2005-q") "a-2000-x")))
                    ((symbol-function 'display-buffer) #'ignore)
                    ((symbol-function 'message) #'ignore))
            ;; no for the parent question: nothing to do
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (p) (push p prompts) nil)))
              (should-error (sp-devonthink-sync-backfill) :type 'user-error))
            (should (string-match-p "crossref parent has one" (car prompts)))
            (with-temp-buffer (insert-file-contents c)
                              (should-not (string-match-p "#\\+devonthink" (buffer-string))))
            ;; yes to both: the parent's UUID is written
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (sp-devonthink-sync-backfill))
            (with-temp-buffer (insert-file-contents c)
                              (should (string-match-p "#\\+devonthink: 11111111" (buffer-string))))))
      (delete-directory dir t))))

(provide 'sp-devonthink-sync-test)
;;; sp-devonthink-sync-test.el ends here
