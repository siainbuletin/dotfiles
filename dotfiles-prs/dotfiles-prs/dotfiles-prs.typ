  #raw(lang:"verbatim", "#+filetags:") (for
  #raw(lang:"verbatim", "sp-tag-emoji")). #raw(lang:"verbatim", "RET")
  visits, #raw(lang:"verbatim", "a") registers,
  #raw(lang:"verbatim", "g") reruns.
  #raw(lang:"verbatim", "sp-org-tag-lint-buffer") does one file.
- #strong[#raw(lang:"verbatim", "sp-org-create-note-and-link")] and
  #strong[wikilink conversion:] both ask for at least one note tag
  (unknown ones can be registered on the spot) and write
  #raw(lang:"verbatim", "#+filetags:").
- #strong[#raw(lang:"verbatim", "sp-split-leave-parents"):] binds
  #raw(lang:"verbatim", "org-use-tag-inheritance") to the new
  #raw(lang:"verbatim", "sp-split-inherit-tags") (nil), only while it
  runs.

