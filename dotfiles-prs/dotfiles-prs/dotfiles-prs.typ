<how>
- Reuses #raw(lang:"verbatim", "sp-litnotes-meta--field=/")--year=
  (braces, LaTeX accents to Unicode, year from
  #raw(lang:"verbatim", "date") or #raw(lang:"verbatim", "crossref"))
  and #raw(lang:"verbatim", "sp-author-notes-bibtex--files").
- New #raw(lang:"verbatim", "sp-litnotes-meta-build-index"): the
  #raw(lang:"verbatim", ".bib") files are read once per run (in a first
  background slice) into
  #raw(lang:"verbatim", "sp-litnotes-meta--index")\;
